---
import DocLayout from '../layouts/DocLayout.astro';
import { doc } from '../docs';
import { render } from 'astro:content';

const entry = await doc('genesis');
const { Content } = await render(entry);
---

<DocLayout
  title="Genesis — Design Document"
  description="Design document for Genesis: a browser city simulation with persistent residents, built cooperatively on one shared map."
>
  <Content />
</DocLayout>
