---
import DocLayout from '../layouts/DocLayout.astro';
import { doc } from '../docs';
import { render } from 'astro:content';

const entry = await doc('research');
const { Content } = await render(entry);
---

<DocLayout
  title="Genesis — Research"
  description="Research behind Genesis: verified evidence from reference games and engine documentation, with proposals kept separate from facts."
>
  <Content />
</DocLayout>
